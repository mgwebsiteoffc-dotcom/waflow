APP_NAME="Whatify Flow"
APP_ENV=local
APP_KEY=
# Generate once and keep stable; otherwise fall back to APP_KEY in development.
DATA_HASH_KEY=
APP_DEBUG=true
APP_URL=https://waflow.whatify.in
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=whatify_flow
DB_USERNAME=whatify_user
DB_PASSWORD=change-this

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,write_orders
SHOPIFY_API_VERSION=2026-10
# Abandoned checkout inactivity window before a recovery workflow may start.
ABANDONED_CHECKOUT_DELAY_MINUTES=60
WHATIFY_BASE_URL=https://whatify.in/api/v1/external
WHATIFY_WEBHOOK_SECRET=

# Schedule `php artisan schedule:run` every minute and run `php artisan queue:work` continuously.
